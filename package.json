{
  "name": "lee-codex",
  "version": "0.1.0",
  "description": "A simple local coding-agent CLI.",
  "type": "module",
  "bin": {
    "lee-codex": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "4.5.14",
    "vitest": "0.34.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
